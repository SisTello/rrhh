generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  GENERAL
  ANNOUNCEMENT
  REQUEST
  CHAT
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  email              String             @unique @db.VarChar(320)
  displayName        String             @db.VarChar(200)
  passwordHash       String?            @db.VarChar(255)
  status             AccountStatus      @default(INVITED)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  employee           Employee?
  userRoles          UserRole[]
  assignedRoles      UserRole[]         @relation("RoleAssignedBy")
  announcements      Announcement[]
  requests           Request[]          @relation("RequestRequester")
  approvals          Approval[]         @relation("ApprovalApprover")
  conversationLinks  ConversationMember[]
  messages           Message[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([status])
  @@map("users")
}

model Employee {
  id             String       @id @default(uuid()) @db.Uuid
  employeeNumber String       @unique @db.VarChar(50)
  userId         String?      @unique @db.Uuid
  departmentId   String?      @db.Uuid
  branchId       String?      @db.Uuid
  positionId     String?      @db.Uuid
  managerId      String?      @db.Uuid
  hiredAt        DateTime?    @db.Date
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  position       Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager        Employee?    @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports  Employee[]   @relation("EmployeeManager")

  @@index([departmentId])
  @@index([branchId])
  @@index([positionId])
  @@index([managerId])
  @@map("employees")
}

model Department {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(150)
  code        String       @unique @db.VarChar(50)
  parentId    String?      @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentHierarchy")
  employees   Employee[]

  @@index([parentId])
  @@map("departments")
}

model Branch {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(150)
  code      String     @unique @db.VarChar(50)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  employees Employee[]

  @@map("branches")
}

model Position {
  id        String     @id @default(uuid()) @db.Uuid
  title     String     @db.VarChar(150)
  code      String     @unique @db.VarChar(50)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  employees Employee[]

  @@map("positions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(150)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  roleLinks   RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String    @db.Uuid
  roleId       String    @db.Uuid
  assignedAt   DateTime  @default(now()) @db.Timestamptz(6)
  assignedById String?   @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?     @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Announcement {
  id          String             @id @default(uuid()) @db.Uuid
  title       String             @db.VarChar(250)
  body        String             @db.Text
  status      AnnouncementStatus @default(DRAFT)
  authorId    String             @db.Uuid
  publishedAt DateTime?          @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  author      User               @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
  @@index([authorId])
  @@map("announcements")
}

model Request {
  id          String        @id @default(uuid()) @db.Uuid
  type        String        @db.VarChar(100)
  payload     Json
  status      RequestStatus @default(PENDING)
  requesterId String        @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)
  requester   User          @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  approvals   Approval[]

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@map("requests")
}

model Approval {
  id          String        @id @default(uuid()) @db.Uuid
  requestId   String        @db.Uuid
  approverId  String        @db.Uuid
  status      ApprovalStatus @default(PENDING)
  comments    String?       @db.Text
  decidedAt   DateTime?     @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)
  request     Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver    User          @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: Restrict)

  @@index([requestId, status])
  @@index([approverId, status])
  @@map("approvals")
}

model Conversation {
  id        String               @id @default(uuid()) @db.Uuid
  title     String?              @db.VarChar(200)
  isGroup   Boolean              @default(false)
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @db.Timestamptz(6)
  members   ConversationMember[]
  messages  Message[]

  @@index([updatedAt])
  @@map("conversations")
}

model ConversationMember {
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  joinedAt       DateTime     @default(now()) @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  body           String       @db.Text
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType @default(GENERAL)
  payload   Json
  readAt    DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(150)
  entityType String   @db.VarChar(150)
  entityId   String?  @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}
